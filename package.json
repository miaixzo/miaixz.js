{
  "name": "miaixz.js",
  "version": "0.8.2",
  "private": true,
  "packageManager": "npm@10.9.3",
  "description": "Build with intelligence. Create without limits.",
  "type": "module",
  "engines": {
    "node": ">=20.19",
    "npm": ">=10"
  },
  "workspaces": [
    "packages/sdk",
    "packages/ui",
    "packages/view",
    "packages/icons"
  ],
  "scripts": {
    "version:set": "bash .github/scripts/version.sh",
    "version:check": "node .github/scripts/release/check-release-metadata.mjs",
    "headers:fix": "node .github/scripts/quality/enforce-source-policy.mjs --write",
    "headers:check": "node .github/scripts/quality/enforce-source-policy.mjs --check",
    "comments:check": "npm run headers:check && npm run lint",
    "icons:generate": "npm run generate --workspace @miaixz/icons",
    "icons:generate:check": "npm run generate:check --workspace @miaixz/icons",
    "icons:refinement:scan": "npm run refinement:scan --workspace @miaixz/icons",
    "icons:consumers:check": "node .github/scripts/modules/icons/quality/read-icon-consumers.mjs --mode check",
    "icons:font:build": "npm run font:build --workspace @miaixz/icons",
    "icons:geometry:measure": "npm run geometry:measure --workspace @miaixz/icons",
    "icons:font:check": "npm run font:check --workspace @miaixz/icons",
    "icons:font:inspect": "node .github/scripts/miaixz.mjs font:inspect",
    "icons:font:render": "node .github/scripts/miaixz.mjs visual:render",
    "icons:visual:validate": "node .github/scripts/miaixz.mjs visual:validate",
    "icons:visual:check": "node .github/scripts/miaixz.mjs visual:check",
    "icons:dependencies:check": "node .github/scripts/modules/icons/quality/validate-dependencies.mjs",
    "build": "node .github/scripts/miaixz.mjs build",
    "typecheck": "node .github/scripts/miaixz.mjs typecheck",
    "lint": "node .github/scripts/miaixz.mjs lint && npm run lint:scripts",
    "lint:scripts": "node .github/scripts/miaixz.mjs lint:scripts",
    "lint:boundaries": "node .github/scripts/quality/audit-import-boundaries.mjs",
    "audit:css": "node .github/scripts/miaixz.mjs audit:css --if-present",
    "test:coverage": "node .github/scripts/miaixz.mjs test:coverage",
    "audit:dependencies": "node .github/scripts/quality/audit-dependencies.mjs",
    "install:all": "node .github/scripts/miaixz.mjs install:all",
    "check:projects": "node .github/scripts/miaixz.mjs check:projects",
    "lockfile:check": "node .github/scripts/quality/check-package-lock.mjs",
    "scripts:names:check": "node .github/scripts/quality/check-script-names.mjs",
    "tests:layout:check": "node .github/scripts/quality/check-test-layout.mjs",
    "plan:check": "node .github/scripts/quality/audit-adjustment-plan.mjs",
    "format": "npm run headers:fix && prettier . --write --ignore-unknown --ignore-path .gitignore",
    "format:check": "prettier . --check --ignore-unknown --ignore-path .gitignore",
    "check:static": "npm run comments:check && npm run lockfile:check && npm run scripts:names:check && npm run tests:layout:check && npm run version:check && npm run plan:check && npm run typecheck && npm run lint:boundaries && npm run icons:dependencies:check && npm run audit:css && npm run test:coverage && npm run format:check",
    "check:browser": "node .github/scripts/miaixz.mjs test:browser --if-present",
    "check:package": "node .github/scripts/miaixz.mjs package:check --if-present && node .github/scripts/package/check-package-contracts.mjs",
    "package:stage": "node .github/scripts/package/stage-workspace-builds.mjs",
    "release:verify": "node .github/scripts/release/check-release-metadata.mjs",
    "release:publish": "node .github/scripts/release/publish-package-tarballs.mjs",
    "release:published": "node .github/scripts/release/check-published-packages.mjs",
    "font:toolchain:install": "python -m pip install --require-hashes -r .github/scripts/modules/icons/fonts/font-toolchain.lock.txt",
    "icons:build": "npm run build --workspace @miaixz/icons",
    "check:clean": "node .github/scripts/quality/check-working-tree.mjs",
    "check": "npm run build && npm run check:static && npm run check:projects && npm run check:browser && npm run check:package && npm run check:clean"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miaixzo/miaixz.js.git"
  },
  "bugs": {
    "url": "https://github.com/miaixzo/miaixz.js/issues"
  },
  "homepage": "https://github.com/miaixzo/miaixz.js#readme",
  "license": "Apache-2.0",
  "author": "The Miaixz Team",
  "devDependencies": {
    "@babel/parser": "8.0.4",
    "prettier": "3.9.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "saxes": "6.0.0",
    "svg-path-bbox": "2.1.0",
    "svg-pathdata": "7.2.0",
    "svgo": "4.1.0"
  }
}
