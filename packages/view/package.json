{
  "name": "@miaixz/view",
  "version": "0.8.1",
  "description": "Composable image, PDF, and Office preview components for Miaixz applications.",
  "type": "module",
  "engines": {
    "node": ">=20.19",
    "npm": ">=10"
  },
  "license": "Apache-2.0",
  "author": "The Miaixz Team",
  "homepage": "https://github.com/818000/miaixz.js#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/818000/miaixz.js.git",
    "directory": "packages/view"
  },
  "bugs": {
    "url": "https://github.com/818000/miaixz.js/issues"
  },
  "keywords": [
    "miaixz",
    "preview",
    "pdf",
    "office",
    "image"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./image": {
      "types": "./dist/shell/image/index.d.ts",
      "import": "./dist/shell/image/index.js"
    },
    "./pdf": {
      "types": "./dist/shell/pdf/index.d.ts",
      "import": "./dist/shell/pdf/index.js"
    },
    "./office": {
      "types": "./dist/shell/office/index.d.ts",
      "import": "./dist/shell/office/index.js"
    },
    "./errors": {
      "types": "./dist/shared/errors/index.d.ts",
      "import": "./dist/shared/errors/index.js"
    },
    "./shared": {
      "types": "./dist/shared/index.d.ts",
      "import": "./dist/shared/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "clean": "node --input-type=module --eval \"import { rm } from 'node:fs/promises'; await rm('dist', { recursive: true, force: true });\"",
    "build": "node ../../.github/scripts/release/generate-project-version.mjs --check && npm run generate:formats && npm run clean && tsc -p tsconfig.build.json && node --input-type=module --eval \"import { cp } from 'node:fs/promises'; await cp('src/shell/styles/view.css', 'dist/styles.css');\"",
    "typecheck": "node ../../.github/scripts/release/generate-project-version.mjs --check && npm run generate:formats:check && tsc -p tsconfig.json --noEmit",
    "lint": "eslint src tests *.config.js *.config.ts --no-error-on-unmatched-pattern && stylelint \"src/**/*.css\"",
    "lint:fix": "eslint src tests *.config.js *.config.ts --no-error-on-unmatched-pattern --fix && stylelint \"src/**/*.css\" --fix",
    "format": "prettier . --write --ignore-path ../../.gitignore",
    "format:check": "prettier . --check --ignore-path ../../.gitignore",
    "test": "node ../../.github/scripts/release/generate-project-version.mjs --check && vitest run",
    "test:browser": "npm run build && playwright test --config playwright.config.ts",
    "test:coverage": "node ../../.github/scripts/release/generate-project-version.mjs --check && vitest run --coverage",
    "generate:formats": "node ../../.github/scripts/modules/view/codegen/generate-format-registry.mjs",
    "generate:formats:check": "node ../../.github/scripts/modules/view/codegen/generate-format-registry.mjs --check",
    "audit:runtime-deps": "node ../../.github/scripts/modules/view/quality/audit-runtime-dependencies.mjs",
    "check:package": "npm run build && node ../../.github/scripts/modules/view/quality/check-package-assets.mjs",
    "test:format-matrix": "vitest run tests/autogen/format-matrix.test.ts",
    "check": "npm run audit:runtime-deps && npm run typecheck && npm run lint && npm run test:coverage && npm run format:check && npm run check:package"
  },
  "peerDependencies": {
    "@miaixz/icons": ">=0.8.1 <0.9.0",
    "react": ">=18.3 <20",
    "react-dom": ">=18.3 <20"
  },
  "dependencies": {},
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@babel/core": "8.0.1",
    "@babel/eslint-parser": "8.0.1",
    "@eslint/js": "10.0.1",
    "@miaixz/icons": "0.8.1",
    "@playwright/test": "1.62.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsdoc": "62.7.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.11.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.6",
    "publint": "0.3.24",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "stylelint": "17.14.1",
    "stylelint-config-recess-order": "7.8.0",
    "stylelint-config-standard": "40.0.0",
    "stylelint-order": "8.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
